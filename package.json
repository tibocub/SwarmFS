{
  "name": "swarmfs",
  "version": "0.0.0",
  "description": "A decentralized filesystem: folders and files as hypergraph records, bytes through swarmwire, served in place.",
  "type": "module",
  "main": "index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": { "types": "./dist/types/index.d.ts", "default": "./index.js" },
    "./lib/*": { "types": "./dist/types/lib/*", "default": "./lib/*" },
    "./package.json": "./package.json",
    "./*": "./*"
  },
  "bin": {
    "swarmfs": "bin/swarmfs.js"
  },
  "license": "MIT",
  "private": true,
  "files": ["index.js", "lib/", "bin/", "dist/types/index.d.ts", "dist/types/lib/", "docs/"],
  "imports": {
    "fs": { "bare": "bare-fs", "default": "fs" },
    "path": { "bare": "bare-path", "default": "path" },
    "os": { "bare": "bare-os", "default": "os" },
    "process": { "bare": "bare-process", "default": "process" },
    "child_process": { "bare": "bare-subprocess", "default": "child_process" },
    "url": { "bare": "bare-url", "default": "url" }
  },
  "scripts": {
    "test": "node scripts/test-runner.js",
    "test:bare": "node scripts/test-runner.js --bare",
    "test:all": "npm test && npm run test:bare",
    "test:slow": "brittle-node test/slow/*.test.js && brittle-bare test/slow/*.test.js",
    "perf": "node perf/run.mjs",
    "perf:compare": "node perf/compare.mjs",
    "typecheck": "tsc -p jsconfig.json",
    "types": "tsc -p jsconfig.json --noEmit false --declaration --emitDeclarationOnly --outDir dist/types && node scripts/types.js",
    "prepack": "npm run types"
  },
  "dependencies": {
    "@types/node": "^26.6.6",
    "hypergraph": "file:../hypergraph",
    "protomux": "^3.12.1",
    "swarmwire-lib": "file:../swarmwire",
    "b4a": "^1.9.0",
    "bare-fs": "^4.8.4",
    "bare-os": "^3.9.3",
    "bare-path": "^3.1.2",
    "bare-process": "^4.5.1"
  },
  "devDependencies": {
    "bare": "^1.34.1",
    "brittle": "^4.5.0",
    "hyperdht": "6.36.0",
    "bare-subprocess": "^6.2.2",
    "bare-url": "^2.5.5",
    "typescript": "~5.9.3"
  },
  "overrides": {
    "hyperdht": "$hyperdht"
  },
  "engines": {
    "bare": ">=1.27",
    "node": ">=20"
  }
}
